    {
      "args": {
        "properties": {
          "addDir": {
            "description": "Extra directories tools may access",
            "items": {
              "type": "string"
            },
            "title": "Additional Dirs",
            "type": "array",
            "x-clicky-order": 2
          },
          "agent": {
            "description": "Agent for the current session",
            "title": "Agent",
            "type": "string",
            "x-clicky-order": 10
          },
          "appendSystemPrompt": {
            "description": "Append to the default system prompt",
            "title": "Append System Prompt",
            "type": "string",
            "x-clicky-order": 7
          },
          "betas": {
            "description": "Beta headers to include in API requests",
            "items": {
              "type": "string"
            },
            "title": "Beta Headers",
            "type": "array",
            "x-clicky-order": 8
          },
          "excludeDynamicSystemPromptSections": {
            "description": "Move per-machine sections to the first user message for prompt-cache reuse",
            "title": "Exclude Dynamic Sections",
            "type": "boolean",
            "x-clicky-order": 9
          },
          "mcpConfig": {
            "description": "Load MCP servers from JSON files or strings",
            "items": {
              "type": "string"
            },
            "title": "MCP Config",
            "type": "array",
            "x-clicky-order": 3
          },
          "safeMode": {
            "description": "Start with all customizations disabled",
            "title": "Safe Mode",
            "type": "boolean",
            "x-clicky-order": 11
          },
          "settings": {
            "description": "Path to a settings JSON file or a JSON string",
            "title": "Settings File/JSON",
            "type": "string",
            "x-clicky-order": 5
          },
          "strictMcpConfig": {
            "description": "Only use MCP servers from --mcp-config",
            "title": "Strict MCP Config",
            "type": "boolean",
            "x-clicky-order": 4
          },
          "systemPrompt": {
            "description": "Replace the default system prompt",
            "title": "System Prompt",
            "type": "string",
            "x-clicky-order": 6
          },
          "tools": {
            "description": "Restrict the built-in tool set (e.g. Bash Edit Read)",
            "items": {
              "type": "string"
            },
            "title": "Built-in Tools",
            "type": "array",
            "x-clicky-order": 1
          }
        },
        "type": "object"
      },
      "authenticated": true,
      "backend": "claude-cmux",
      "binary": "/Users/moshe/.local/bin/claude",
      "kind": "cli",
      "models": [
        "claude-agent-sonnet",
        "claude-agent-opus",
        "claude-agent-haiku"
