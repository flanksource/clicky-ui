    "$id": "https://github.com/flanksource/captain/pkg/api/spec",
    "$ref": "#/$defs/Spec",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "if": {
          "properties": {
            "backend": {
              "const": "anthropic"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": false,
            "model": {
              "enum": [
                "claude-fable-5",
                "claude-opus-4-8",
                "claude-sonnet-5",
                "claude-haiku-4-5"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "gemini"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": false,
            "model": {
              "enum": ["gemini-2.5-pro", "gemini-3.0-pro", "gemini-3.5-flash"]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "openai"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": false,
            "model": {
              "enum": ["gpt-5.5", "gpt-5.4-mini"]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "deepseek"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": false,
            "model": {
              "enum": ["deepseek-chat", "deepseek-reasoner"]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "claude-cli"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": false,
            "model": {
              "enum": [
                "claude-agent-sonnet",
                "claude-agent-opus",
                "claude-agent-haiku"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "claude-agent"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": false,
            "model": {
              "enum": [
                "claude-agent-sonnet",
                "claude-agent-opus",
                "claude-agent-haiku"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "claude-cmux"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": {
              "$ref": "#/$defs/claudeCmuxArgs"
            },
            "model": {
              "enum": [
                "claude-agent-sonnet",
                "claude-agent-opus",
                "claude-agent-haiku"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "codex-cli"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": false,
            "model": {
              "enum": ["gpt-5-codex"]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "codex-cmux"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": {
              "$ref": "#/$defs/codexCmuxArgs"
            },
            "model": {
              "enum": ["gpt-5-codex"]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "backend": {
              "const": "gemini-cli"
            }
          },
          "required": ["backend"]
        },
        "then": {
          "properties": {
            "cliArgs": false
          }
        }
      }
    ]
  }
