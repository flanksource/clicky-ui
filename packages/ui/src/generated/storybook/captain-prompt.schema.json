  "examples": {
    "spec": {
      "backend": "claude-cmux",
      "budget": {
        "cost": 0.5,
        "maxTokens": 8000,
        "maxTurns": 6,
        "timeout": "30m"
      },
      "cliArgs": {
        "addDir": ["packages/ui"],
        "mcpConfig": ["./mcp.json"]
      },
      "effort": "medium",
      "memory": {
        "skills": [".agents/skills/example-skill"],
        "skipHooks": true
      },
      "model": "claude-sonnet-5",
      "noCache": true,
      "permissions": {
        "mcp": {
          "filesystem": "enabled",
          "gavel": "disabled"
        },
        "mode": "acceptEdits",
        "plugins": {
          ".claude/plugins/example": "disabled"
        },
        "presets": ["edit"],
        "skills": {
          ".agents/skills/example-skill": "enabled"
        },
        "tools": {
          "Bash": "deny",
          "Edit": "ask",
          "Read": "allow"
        }
      },
      "prompt": {
        "appendSystem": "Prefer existing clicky-ui primitives.",
        "system": "Answer with direct implementation guidance.",
        "user": "Update the prompt runtime editor and keep the payload compact."
      },
      "setup": {
        "baseDir": ".shell",
        "cwd": ".",
        "dotenv": [".env", ".env.local"],
        "envVars": [
          {
            "name": "CAPTAIN_RUNTIME",
            "value": "storybook"
          },
          {
            "name": "GAVEL_PROFILE",
            "value": "local"
          }
        ]
      },
      "temperature": 0.2
    }
  },
