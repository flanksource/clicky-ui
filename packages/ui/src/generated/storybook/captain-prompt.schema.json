      "ready": true
    },
    {
      "authEnvVars": ["OPENAI_API_KEY"],
      "authenticated": true,
      "backend": "codex-cli",
      "binary": "/Users/moshe/Library/pnpm/codex",
      "kind": "cli",
      "models": ["gpt-5-codex"],
      "ready": true
    },
    {
      "args": {
        "properties": {
          "addDir": {
            "description": "Extra writable directories",
            "items": {
              "type": "string"
            },
            "title": "Additional Dirs",
            "type": "array",
            "x-clicky-order": 5
          },
          "askForApproval": {
            "default": "on-request",
            "description": "When codex asks for human approval before running a command",
            "enum": ["untrusted", "on-failure", "on-request", "never"],
            "title": "Approval Policy",
            "type": "string",
            "x-clicky-order": 2,
            "x-enum-display": "radio",
            "x-enum-labels": {
              "never": "Never",
              "on-failure": "On failure (deprecated)",
              "on-request": "On request",
              "untrusted": "Untrusted only"
            }
          },
          "config": {
            "description": "Override config values as key=value",
            "items": {
              "type": "string"
            },
            "title": "Config Overrides",
            "type": "array",
            "x-clicky-order": 3
          },
          "disable": {
            "description": "Disable named features",
            "items": {
              "type": "string"
            },
            "title": "Disable Features",
            "type": "array",
            "x-clicky-order": 7
          },
          "enable": {
            "description": "Enable named features",
            "items": {
              "type": "string"
            },
            "title": "Enable Features",
            "type": "array",
            "x-clicky-order": 6
          },
          "image": {
            "description": "Image files to attach to the initial prompt",
            "items": {
              "type": "string"
            },
            "title": "Images",
            "type": "array",
            "x-clicky-order": 11
          },
          "oss": {
            "description": "Use an open-source model provider",
            "title": "OSS Provider",
            "type": "boolean",
            "x-clicky-order": 10
          },
          "profile": {
            "description": "Config profile to layer on the base config",
            "title": "Profile",
            "type": "string",
            "x-clicky-order": 4
          },
          "sandbox": {
            "default": "read-only",
            "description": "Sandbox policy for model-run shell commands",
            "enum": ["read-only", "workspace-write", "danger-full-access"],
            "title": "Sandbox",
            "type": "string",
            "x-clicky-order": 1,
            "x-enum-display": "radio",
            "x-enum-labels": {
              "danger-full-access": "Danger: full access",
              "read-only": "Read-only",
              "workspace-write": "Workspace write"
            }
          },
          "search": {
            "description": "Enable live web search",
            "title": "Web Search",
            "type": "boolean",
            "x-clicky-order": 9
          },
          "strictConfig": {
            "description": "Error on unrecognized config fields",
            "title": "Strict Config",
            "type": "boolean",
            "x-clicky-order": 8
          }
        },
        "type": "object"
      },
      "authenticated": true,
      "backend": "codex-cmux",
      "binary": "/Users/moshe/Library/pnpm/codex",
      "kind": "cli",
      "models": ["gpt-5-codex"],
