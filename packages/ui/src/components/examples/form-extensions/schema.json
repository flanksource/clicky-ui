{
  "type": "object",
  "title": "Service",
  "x-clicky-extensions": [{ "ref": "examples/form-extensions/extension.tsx" }],
  "x-order":["name", "color", "owner", "replicas", "endpoints", "notes"],
  "required": ["name", "owner"],
  "properties": {
    "name": { "type": "string", "title": "Name" },
    "color": {
      "type": "string",
      "title": "Accent",
      "format": "color",
      "examples": ["#0ea5e9", "#22c55e", "#f97316"],
      "default": "#0ea5e9"
    },
    "owner": {
      "type": "string",
      "title": "Owner",
      "x-clicky-lookup": { "url": "ext:team-members", "filter": "id" }
    },
    "replicas": {
      "type": "integer",
      "title": "Replicas",
      "format": "stepper",
      "minimum": 1,
      "maximum": 10,
      "multipleOf": 1
    },
    "endpoints": {
      "type": "array",
      "title": "Endpoints",
      "x-layout": "chips",
      "items": { "type": "string", "format": "uri" }
    },
    "notes": { "type": "string", "title": "Notes", "format": "md" }
  }
}
