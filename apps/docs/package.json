{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run generate:api && astro dev",
    "build": "pnpm --filter @flanksource/clicky-ui build:icons && pnpm --filter storybook exec storybook build --disable-telemetry && pnpm run build:site && node scripts/copy-storybook.mjs",
