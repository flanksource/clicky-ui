    "preview": "astro preview",
    "generate:api": "node scripts/generate-component-api.mjs"
  },
  "devDependencies": {
    "@astrojs/starlight": "catalog:",
    "astro": "catalog:",
    "prettier": "catalog:",
    "react-docgen-typescript": "^2.4.0",
    "typescript": "catalog:"
  }
}
