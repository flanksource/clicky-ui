{
  "name": "e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:responsive": "playwright test responsive",
    "test:page-host": "E2E_PAGE_HOST=1 playwright test --project=page-host --workers=1",
    "test:playground-frames": "gavel test --work-dir . --framework playwright --recursive=false --test-timeout 15m --timeout 20m -- --config playground-frames.config.ts --project=playground-frames",
    "report:responsive": "node scripts/responsive-report.mjs",
    "lint": "oxlint tests playwright.config.ts --deny-warnings",
    "check": "tsc -p tsconfig.json --noEmit && pnpm run lint"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "typescript": "catalog:"
  }
}
