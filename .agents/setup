#!/usr/bin/env bash
# Prepares a fresh Amp orb: CLI tools, Google Chrome for Playwright, and workspace dependencies.
# Runs again on stale snapshots, so every step skips or cheaply repeats work that is already done.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

DEPS_VERSION=1.0.51
GAVEL_VERSION=0.0.86
CAPTAIN_VERSION=0.0.66
BETTERLEAKS_VERSION=1.10.1
TSRS_VERSION=7.1.0-beta.tsrs3

# Login shells already have ~/.local/bin on PATH; deps installs there by default.
BIN_DIR="$HOME/.local/bin"
export PATH="$BIN_DIR:$PATH"

step() {
  local label=$1
  shift
  local start=$SECONDS
  echo "==> ${label}"
  "$@"
  echo "<== ${label} ($((SECONDS - start))s)"
}

install_deps() {
  local dir="$HOME/.local/opt/deps/$DEPS_VERSION"
  if [[ ! -x "$dir/deps" ]]; then
    mkdir -p "$dir"
    curl -fsSL "https://github.com/flanksource/deps/releases/download/v${DEPS_VERSION}/deps-linux-amd64.tar.gz" |
      tar -xz -C "$dir" deps
  fi
  mkdir -p "$BIN_DIR"
  ln -sfn "$dir/deps" "$BIN_DIR/deps"
}

# deps reinstalls from its download cache (~/.deps/cache) on every run, which takes seconds.
install_binaries() {
  deps install \
    "flanksource/gavel@v${GAVEL_VERSION}" \
    "flanksource/captain@v${CAPTAIN_VERSION}" \
    "betterleaks/betterleaks@v${BETTERLEAKS_VERSION}"
}

# tsrs ships only as an npm package.
install_tsrs() {
  local pkg="$HOME/.local/lib/node_modules/tsrs/package.json"
  if [[ ! -f "$pkg" ]] || [[ "$(node -p "require('$pkg').version")" != "$TSRS_VERSION" ]]; then
    npm install --global --prefix "$HOME/.local" --no-fund --no-audit "tsrs@${TSRS_VERSION}"
  fi
}

install_dependencies() {
  pnpm install --frozen-lockfile
}

# Storybook's vitest browser tests and the e2e suite launch Playwright with channel "chrome",
# which needs Google Chrome at /opt/google/chrome. apt resolves its system libraries.
install_chrome() {
  if [[ ! -x /opt/google/chrome/chrome ]]; then
    local deb=/tmp/google-chrome-stable_current_amd64.deb
    curl -fsSL -o "$deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    sudo apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$deb"
    rm -f "$deb"
  fi
}

# Generates packages/ui/src/icons (gitignored), which typecheck, lint, and tests import.
build_icons() {
  pnpm --filter @flanksource/clicky-ui run build:icons
}

step "deps" install_deps
step "gavel, captain, betterleaks (deps)" install_binaries
step "tsrs" install_tsrs
step "pnpm install" install_dependencies
step "Google Chrome for Playwright" install_chrome
step "Icon codegen" build_icons
